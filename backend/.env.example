# Copy this file to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/smart_expense_tracker

# Secret used to sign JWT access tokens. Use a long random string in any real environment.
JWT_SECRET_KEY=replace-with-a-long-random-string

# Optional — defaults shown.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Must match the frontend's origin exactly (used for CORS and cookie scoping).
FRONTEND_ORIGIN=http://localhost:5173

# Set to true only when serving over HTTPS in production (controls the cookie's Secure flag).
COOKIE_SECURE=false

# Gemini API key (https://aistudio.google.com/). Optional — AI features return a 503
# with a clear error message if this is not set, rather than failing to start.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
